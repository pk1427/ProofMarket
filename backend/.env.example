# Required: wallet used to read and manage the Calibration testnet account.
# Never commit a real private key.
SYNAPSE_PRIVATE_KEY=

# Optional: enables the Claude explanation. Without it, ProofMarket uses its
# built-in rules-based explanation and the decision loop still works.
OPENROUTER_API_KEY=

# API server
PORT=3001

# Comma-separated browser origins permitted to call this API.
# Add the deployed frontend URL before a public demo.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Decision policy, in Filecoin epochs. These defaults are calibrated for the
# current demo account; do not change them during a recorded run without testing.
TRIAGE_THRESHOLD_EPOCHS=100000000
RESUME_MARGIN_EPOCHS=10000000
